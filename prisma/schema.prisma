generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterProfile {
  id           String   @id @default(uuid())
  clerkUserId  String   @unique
  resume       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ResumeDocument {
  id           String   @id @default(uuid())
  clerkUserId  String
  name         String
  resume       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clerkUserId])
}
